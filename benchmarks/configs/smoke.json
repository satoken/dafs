{
  "binary": "../../build/src/dafs",
  "output_dir": "../results-smoke",
  "timeout_seconds": 60,
  "repetitions": 1,
  "random_seed": 42,
  "environment": {
    "OMP_NUM_THREADS": "1"
  },
  "datasets": [
    {
      "id": "tiny",
      "input": "../../tests/data/tiny.fa",
      "reference": "../../tests/data/tiny_reference.sto"
    }
  ],
  "conditions": [
    {
      "id": "linear_no_ribosum",
      "args": [
        "-a", "LinearAlign",
        "-s", "lpc",
        "--no-alifold",
        "--dynamic-cbp",
        "--ribosum-weight=0",
        "--max-iter=2"
      ]
    },
    {
      "id": "linear_ribosum_01",
      "args": [
        "-a", "LinearAlign",
        "-s", "lpc",
        "--no-alifold",
        "--dynamic-cbp",
        "--ribosum-weight=0.1",
        "--max-iter=2"
      ]
    }
  ]
}
