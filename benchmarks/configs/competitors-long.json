{
  "method_group": "long-reference-backed-rna",
  "output_dir": "../results-competitors-long",
  "timeout_seconds": 7200,
  "repetitions": 1,
  "random_seed": 42,
  "environment": {"OMP_NUM_THREADS": "1", "MAFFT_BINARIES": "../tools/install/mafft-7.526/libexec/mafft", "LARA2_BIN_DIR": "../tools/install/lara-2.0.1/bin", "TCOFFEE_BIN_DIR": "../tools/install/tcoffee/bin"},
  "dataset_manifests": ["../data/rfam11-long/manifest.json"],
  "sci": {"version": "2.7.2", "timeout_seconds": 1800},
  "methods": [
    {
      "id": "locarna-2.0.1",
      "name": "LocARNA 2.0.1",
      "binary": "mlocarna",
      "argv": ["{binary}", "--quiet", "--keep-sequence-order", "--tgtdir", "{run_dir}/tool", "{input}"],
      "output_mode": "path",
      "output_path": "{run_dir}/tool/results/result.aln",
      "consensus_structure": "rnaalifold"
    },
    {
      "id": "raf-1.0.0",
      "name": "RAF 1.0.0",
      "binary": "raf",
      "argv": ["{binary}", "predict", "{input}"],
      "output_mode": "stdout",
      "consensus_structure": "rnaalifold"
    },
    {
      "id": "centroidalign-1.00",
      "name": "CentroidAlign 1.00",
      "binary": "centroidalign",
      "argv": ["{binary}", "{input}"],
      "output_mode": "stdout",
      "consensus_structure": "rnaalifold"
    },
    {
      "id": "mafft-qinsi-7.526",
      "name": "MAFFT Q-INS-i 7.526",
      "binary": "mafft-qinsi",
      "argv": ["{binary}", "--thread", "1", "{input}"],
      "output_mode": "stdout",
      "consensus_structure": "rnaalifold"
    },
    {
      "id": "mafft-ginsi-7.526",
      "name": "MAFFT G-INS-i 7.526",
      "binary": "ginsi",
      "argv": ["{binary}", "--thread", "1", "{input}"],
      "output_mode": "stdout",
      "consensus_structure": "rnaalifold"
    },
    {"id": "rnamountalign-1.0", "name": "RNAmountAlign 1.0", "binary": "../tools/install/rnamountalign-1.0/bin/RNAmountAlign", "argv": ["{binary}", "-f", "{input}", "-format", "fasta", "-o", "{run_dir}/tool/rnamountalign.fa"], "output_mode": "path", "output_path": "{run_dir}/tool/rnamountalign.fa", "input_alphabet": "ACGTU", "consensus_structure": "rnaalifold"},
    {"id": "lara2-tcoffee-13.46.2", "name": "LaRA2 2.0.1 + T-Coffee 13.46.2", "binary": "../tools/lara2_tcoffee_wrapper.py", "argv": ["{binary}", "--input", "{input}", "--output", "{run_dir}/tool/lara2-tcoffee.fa"], "output_mode": "path", "output_path": "{run_dir}/tool/lara2-tcoffee.fa", "consensus_structure": "rnaalifold"}
  ]
}
